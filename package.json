{
  "name": "mytube",
  "productName": "MyTube",
  "version": "1.0.0",
  "description": "Download YouTube videos, transcripts, and slide images",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/review-fixes.js",
    "test:slides": "node test/slides-detector.js && node test/pdf.js",
    "test:e2e": "electron test/e2e.js",
    "test:ui": "node test/ui-test.js",
    "test:ui-delete": "node test/ui-delete-test.js",
    "dist": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.mytube.downloader",
    "productName": "MyTube",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true
  }
}
